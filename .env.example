# ═══════════════════════════════════════════════════════════════════════════════
# StoreBot Environment Variables
# Copy to .env and fill in values.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Production Minimum (required for bot to start) ───────────────────────────
MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority"
DBName="storebot"
MANAGER_BOT_TOKEN="123456:ABC-DEF..."
TELEGRAM_ADMIN_IDS="123456789,987654321"
API_KEY_ENCRYPTION_SECRET="generate_a_random_32_plus_character_string_here"

# ─── Optional - Single admin fallback ─────────────────────────────────────────
# Only needed if TELEGRAM_ADMIN_IDS is not set above.
# TELEGRAM_ADMIN_ID="123456789"

# ─── Optional - Language ──────────────────────────────────────────────────────
# Default: en (also supports: ar, fr)
# BOT_LANGUAGE=en

# ─── Optional - NOWPayments integration ───────────────────────────────────────
# Required for subscription payments. Sellers can also set their own keys.
# NOWPAYMENTS_API_KEY="your_platform_nowpayments_api_key"
# NOWPAYMENTS_IPN_SECRET="your_ipn_webhook_secret"
# NOWPAYMENTS_API_URL="https://api.nowpayments.io/v1"

# ─── Optional - Webhook / Deployment ──────────────────────────────────────────
# WEBHOOK_URL="https://yourdomain.com"    # Public URL for IPN callbacks
# WEBHOOK_PORT=3000                        # Express listen port (default: 3000)

# ─── Optional - Frontend ──────────────────────────────────────────────────────
# FRONTEND_URL="https://yourdomain.com"

# ─── Optional - Support links ─────────────────────────────────────────────────
# Shown to users when they have insufficient balance.
# SUPPORT_WHATSAPP_URL="https://wa.me/213776863561"
# SUPPORT_TELEGRAM_URL="https://t.me/Jeogooussama"

# ─── Optional - Logging ───────────────────────────────────────────────────────
# LOG_LEVEL=info           # pino log level: trace, debug, info, warn, error, fatal
# LOG_DIR=logs             # Directory for daily log files
# LOG_PRETTY_FILE=true     # Write human-readable log files (set false in containers)
# NODE_ENV=development     # Set to "production" in deployment
